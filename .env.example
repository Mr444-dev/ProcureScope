# Copy to .env before running docker compose and replace passwords.
POSTGRES_USER=procurescope
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=procurescope
MINIO_ROOT_USER=procurescope
MINIO_ROOT_PASSWORD=change-this-minio-password
MINIO_BUCKET=procurescope-bronze

# TED publishes public notices. The query is a TED Expert Search expression.
TED_API_URL=https://api.ted.europa.eu/v3/notices/search
TED_PAGE_SIZE=100
TED_QUERY_TEMPLATE=publication-date = ({start} <> {end}) AND classification-cpv = 72* AND place-of-performance IN (POL)
TED_DAYS_BACKFILL=548

# Optional filters. Country of the buyer is separate from place of performance.
DATABASE_URL=postgresql://procurescope:change-this-local-password@postgres:5432/procurescope
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://procurescope:change-this-local-password@postgres:5432/airflow
POSTGRES_INITDB_ARGS=--encoding=UTF8
STORAGE_BACKEND=s3
BRONZE_LOCAL_PATH=./data/bronze
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=procurescope
S3_SECRET_KEY=change-this-minio-password
S3_BUCKET=procurescope-bronze

# Airflow web UI demo credentials. Change them for any shared deployment.
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change-this-airflow-password
